# Canonical origin for metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://www.currencyalliance.com

# Set to 1 on publicly accessible staging deployments.
SITE_NOINDEX=0

# Existing website backend and the full value of its Authorization header
API_URL=https://api.currencyalliance.com
WEBSITE_AUTHORIZATION_KEY=

# Public reCAPTCHA v3 site key for the website domain. The paired secret stays in Django.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# WordPress origin for Insights and Case Studies
NEXT_PUBLIC_BLOG_URL=https://blog.currencyalliance.com
